  RewriteRule ^wp-content/uploads/2026/07/split-storm-1448(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/office-cubicles-drying.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/split-storm-1448(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/van-fallen-tree.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/split-storm-1448-1(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/hero-flood.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/split-storm-960(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/van-fallen-tree.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/split-storm-960(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/technician-vacuum-hardwood.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/split-storm-960-1(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/office-corridor-drying.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-480(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/hero-fire.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-480(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/team-storefront.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-480-1(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/hero-storm.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-760(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/photos/team-storefront.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-760(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/hero-flood.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/team-760-1(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/photos/team-storefront.jpg [R=301,L,NC]
  # Old uploads that are not used on the new site (stock photos from the old theme, placeholders, an archive).
  RewriteRule ^wp-content/uploads/2025/04/1200x800(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/1_UmnAYxPdxV7NVIRsYgb4lQ(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/5eddfc7cb203c(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/AdobeStock_123400658(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/AdobeStock_20903474(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/Chapter-4-CCHA-8(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/Ecosan-Flood-Water-Damage-Restoration-01(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/Mold-Remove(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/Water-Damage-Restoration-Services(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/WaterDamage-1920w(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/WhatsApp-Image-2023-10-16-at-00\.33\.53-1(?:-\d+x\d+)?\.jpeg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/XXXL(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/bd576937894507\.574fb5f22b175-scaled-1(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/channels4_profile(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/floor(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/h1_4555(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/incendio-em-condominio-1\.38279bf\.060e83a13ae88ca67383eba9ec31df06(?:-\d+x\d+)?\.jpg$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/placeholder(?:-\d+x\d+)?\.png$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/placeholder-1(?:-\d+x\d+)?\.png$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/placeholder-2(?:-\d+x\d+)?\.png$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/placeholder-3(?:-\d+x\d+)?\.png$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/placeholder-4(?:-\d+x\d+)?\.png$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2025/04/stock-photo-burnt-out-house-with-charred-roof-trusses-and-burnt-furniture-1-1(?:-\d+x\d+)?\.webp$ - [G,L,NC]
  RewriteRule ^wp-content/uploads/2026/07/updated-pages-html(?:-\d+x\d+)?\.zip$ - [G,L,NC]
  RewriteRule ^wp-content/ - [G,L,NC]
  # ---- end of old WordPress URLs ----

  # Pages live at /page/ (page/index.html): add the missing slash, on https.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP: what the pages load. Google Analytics 4 (gtag), Google Maps embeds, Sanity images, and the
  # GoHighLevel (LeadConnector) chat widget once it is switched on. New third-party tags need their hosts here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.leadconnectorhq.com https://*.msgsndr.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://*.msgsndr.com; img-src 'self' data: blob: https://cdn.sanity.io https://*.google-analytics.com https://*.googletagmanager.com https://*.google.com https://*.gstatic.com https://*.leadconnectorhq.com https://*.msgsndr.com; font-src 'self' data: https://*.leadconnectorhq.com https://*.msgsndr.com; connect-src 'self' https://www.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com; frame-src 'self' https://www.google.com https://maps.google.com https://*.leadconnectorhq.com https://*.msgsndr.com; media-src 'self' https://*.leadconnectorhq.com https://*.msgsndr.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files a year, photos a month, pages always revalidated.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Compress text files. Apache serves .js as text/javascript, so both JavaScript types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
