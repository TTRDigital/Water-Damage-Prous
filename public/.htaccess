  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=141(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/mclean/ [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=142(?:&|$)
