# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read at build time
# (build time). Never commit real values.

# --- Sanity (project q30nj6mr / production are the defaults in sanity/env.ts; the site shows its
# built-in copy wherever the CMS is empty).
NEXT_PUBLIC_SANITY_PROJECT_ID=q30nj6mr
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Sanity on Vercel (Vercel Project Settings, Environment Variables; never committed)
# Viewer token "TTR OS read" (sanity.io/manage, API, Tokens): draft previews for TTR OS. Production and Preview, Sensitive.
SANITY_READ_TOKEN=
# Signs the /api/preview links TTR OS makes. SANITY_PREVIEW_SECRET is read if this is empty.
PREVIEW_SECRET=
# Same value in the Sanity publish webhook: POST https://waterdamageprous.com/api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Site
NEXT_PUBLIC_SITE_URL=https://waterdamageprous.com

# --- GoHighLevel
# The forms' webhook is NOT set here: it lives in api/lead-config.php on SiteGround, written by the
# deploy workflow from the GHL_WEBHOOK_URL secret. Until it is set, the forms accept requests but do
# not forward them.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty or "off" hides the chat.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics. GA4 defaults to the old site's tag (G-F3JQ9WQY4G); "off" removes it.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
